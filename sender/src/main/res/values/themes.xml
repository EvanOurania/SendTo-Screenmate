<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Theme for Splash Screen (Official Android API) -->
    <style name="Theme.SendToScreenMate.Starting" parent="Theme.SplashScreen">
        <!-- THE FIX: Use colorBackground to follow system theme (white in light mode, dark in dark mode) -->
        <item name="windowSplashScreenBackground">?android:attr/colorBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.SendToScreenMate</item>
    </style>

    <!-- Main theme for Settings screen -->
    <style name="Theme.SendToScreenMate" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <!-- Ensure splash background matches app background during transition -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">?android:attr/colorBackground</item>
    </style>

    <!-- Transparent theme for Quick Send popup -->
    <style name="Theme.SendToScreenMate.Transparent" parent="Theme.SendToScreenMate">
        <!-- For the Quick Send popup, we keep a dark/dimmed splash to blend with the dimming effect,
             but using a dynamic attribute is also an option. For now, matching system background
             is the safest for a smooth transition. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">?android:attr/colorBackground</item>

        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>
</resources>
